# Copy to backend/.env (or project-root .env if you keep a single file).
# Never commit real secrets.

# --- Database (local PostgreSQL 18) ---
DATABASE_URL=postgres://safa:YOUR_PASSWORD@localhost:5432/dhaka_tesla_pool

# --- API ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# --- Gmail SMTP (use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Dhaka Tesla Pool <your-gmail@gmail.com>"
